domain minecraft

type Block
type Container < Block
type Dim
type Item
type Tool < Item
type Structure
type Building < Structure
type Portal < Building
type Entity 
type Recipe
type ToolTier
type ItemTag
type BlockTag

const nether end overworld : Dim
const nether_portal_nether nether_portal_overworld : Portal
const end_portal lit_end_portal center_portal lit_center_portal : Portal
const i_eye_of_ender i_obsidian : Item
const i_air: Tool # bare hand
const i_wooden_pickaxe i_stone_pickaxe i_iron_pickaxe : Tool
const i_diamond_pickaxe i_gold_pickaxe i_netherite_pickaxe : Tool
const tool_tier_0 tool_tier_1 tool_tier_2 tool_tier_3 : ToolTier
const e_ender_dragon : Entity
# MACRO CONSTS

pred in_dim(dim: Dim)                               # state
pred has_item(item: Item)                           # state
pred near_block(btype: Block)                       # state
pred near_entity(entity: Entity)                    # state
pred near_item_entity(item: Item)                   # state
pred near_structure(structure: Structure)           # state
pred near_container_containing(ctype: Container, item: Item) # state
pred structure_memorized(stype: Structure)          # state
pred findable_block_in_dim(btype: Block, dim: Dim)  # domain
pred can_reap_block(tool: Tool, btype: Block)       # domain
pred can_reap_entity(tool: Tool, etype: Entity)     # domain
pred reaped_block_becomes(btype: Block, item: Item) # domain
pred reaped_entity_becomes(etype: Entity, item: Item) # domain
pred mined_becomes(btype: Block, item: Item)        # domain
pred placed_becomes(item: Item, btype: Block)       # domain
pred leads_to(portal: Portal, dim: Dim)             # domain
pred recipe_produces(recipe: Recipe, item: Item)    # domain
pred killed_becomes(entity: Entity, item: Item)     # domain
pred findable_structure_in_dim(structure: Structure, dim: Dim)  # domain
pred findable_entity_in_dim(entity: Entity, dim: Dim) # domain
pred can_mine_tier(tool: Tool, tier: ToolTier)      # domain
pred mining_requires_tier(btype: Block, tier: ToolTier) # domain
pred item_tag(item: Item, tag: ItemTag)             # domain
pred block_tag(btype: Item, tag: BlockTag)          # domain


action dono


## Blocks

task reach-block(btype: Block)

reach-block : find(btype: Block)
    - find-block(btype)
##reach-block : place(btype: Block, item: Item)
##    - place-block(btype, item)
reach-block : craft-n-place(btype: Block, item: Item)
    - craft-item(item)
    - place-block(btype, item)


task find-block(btype: Block)

find-block : dono(btype: Block)
    < near_block(btype)
    - dono
find-block : find(btype: Block, dim: Dim)
    < findable_block_in_dim(btype, dim)
    - goto-dim(dim)
    - find-block-in-dim(btype, dim)


## Mining requires a certain level for drops for certain items
## A little more methods, otherwise every tool x item combination would need
## a can_mine(tool: Tool, btype: Block) entry
task mine-block(btype: Block, res_item: Item) # remove tool here maybe?

mine-block : no-pickaxe(btype: Block, tool: Tool, res_item: Item)
    < ~mining_requires_tier(btype, tool_tier_3)
    < ~mining_requires_tier(btype, tool_tier_2)
    < ~mining_requires_tier(btype, tool_tier_1)
    < ~mining_requires_tier(btype, tool_tier_0)
    - mine-block-directly(btype, tool, res_item)
mine-block : pickaxe-0(btype: Block, tool: Tool, res_item: Item)
    < can_mine_tier(tool, tool_tier_0)
    < mining_requires_tier(btype, tool_tier_0)
    - mine-block-directly(btype, tool, res_item)
mine-block : pickaxe-1(btype: Block, tool: Tool, res_item: Item)
    < can_mine_tier(tool, tool_tier_1)
    < mining_requires_tier(btype, tool_tier_1)
    - mine-block-directly(btype, tool, res_item)
mine-block : pickaxe-2(btype: Block, tool: Tool, res_item: Item)
    < can_mine_tier(tool, tool_tier_2)
    < mining_requires_tier(btype, tool_tier_2)
    - mine-block-directly(btype, tool, res_item)
mine-block : pickaxe-3(btype: Block, tool: Tool, res_item: Item)
    < can_mine_tier(tool, tool_tier_3)
    < mining_requires_tier(btype, tool_tier_3)
    - mine-block-directly(btype, tool, res_item)


action mine-block-directly(btype: Block, tool: Tool, res_item: Item)
    ## btype 1 -> res_item 1
    < near_block(btype)
    < has_item(tool)
    < mined_becomes(btype, res_item)
    => ~near_block(btype)
    => has_item(res_item)

action reap-block(btype: Block, tool: Tool, res_item: Item)
    ## btype 1 -> res_item 1
    < near_block(btype)
    < can_reap_block(tool, btype)
    < reaped_block_becomes(btype, res_item)
    => has_item(res_item)

## integrate the effect of reduction in the item nr
action place-block(btype: Block, item: Item)
    ## item 1 -> btype 1
    < has_item(item)
    < placed_becomes(item, btype)
    => near_block(btype)

## move precondition from task find-block?
action find-block-in-dim(btype: Block, dim: Dim)
    ## -> btype 1
    < in_dim(dim)
    => (all b: Block) ~near_block(b)
    => (all e: Entity) ~near_entity(e)
    => (all s: Structure) ~near_structure(s)
    => near_block(btype)

action container-put(ctype: Container, item: Item)
    ## item 1 ->
    < near_block(ctype)
    < has_item(item)

action container-take(ctype: Container, item: Item)
    ## -> item 1
    < near_container_containing(ctype, item)
    => has_item(item)



## Entity

task kill-entity(entity: Entity)

kill-entity : kill(entity: Entity)
    - find-entity(entity)
    - kill-entity-directly(entity)

task kill-entity-for-item(entity: Entity, res_item: Item)

kill-entity-for-item : kill(entity: Entity, res_item: Item)
    - find-entity(entity)
    - kill-entity-directly-for-item(entity, res_item)

## TODO: implement drops
## TODO: e_ender_dragon: lit_center_portal activates
action kill-entity-directly(entity: Entity)
    < near_entity(entity)
    => ~near_entity(entity)

action kill-entity-directly-for-item(entity: Entity, res_item: Item)
    ## entity 1 -> res_item 1
    < near_entity(entity)
    < killed_becomes(entity, res_item)
    => ~near_entity(entity)
    => has_item(res_item)

action reap-entity(entity: Entity, tool: Tool, res_item: Item)
    < reaped_entity_becomes(entity, res_item)
    < can_reap_entity(tool, entity)
    < has_item(tool)

task find-entity(etype: Entity)

find-entity : dono(etype: Entity)
    < near_entity(etype)
    - dono
find-entity : find(etype: Entity, dim: Dim)
    < findable_entity_in_dim(etype, dim)
    - goto-dim(dim)
    - find-entity-in-dim(etype, dim)

action find-entity-in-dim(etype: Entity, dim: Dim)
    ## -> etype 1
    < in_dim(dim)
    => (all b: Block) ~near_block(b)
    => (all e: Entity) ~near_entity(e)
    => (all s: Structure) ~near_structure(s)
    => near_entity(etype)


## Travel

task goto-dim(dim: Dim)

goto-dim : dono(dim: Dim)
    < in_dim(dim)
    - dono
goto-dim : overworld-nether(dim: Dim)
    < in_dim(overworld)
    < dim = nether
    - reach-structure(nether_portal_overworld)
    - enter-portal(nether_portal_overworld)
goto-dim : overworld-end(dim: Dim)
    < in_dim(overworld)
    < dim = end
    - reach-structure(lit_end_portal)
    - enter-portal(lit_end_portal)
goto-dim : nether-overworld(dim: Dim)
    < in_dim(nether)
    < dim = overworld
    - reach-structure(nether_portal_nether)
    - enter-portal(nether_portal_nether)
goto-dim : end-overworld(dim: Dim)
    < in_dim(end)
    < dim = overworld
    - reach-structure(lit_center_portal)
    - enter-portal(lit_center_portal)

task enter-portal(portal_type: Portal)
enter-portal : po(portal_type: Portal, dim: Dim)
    - enter-portal-dim(portal_type, dim)

action enter-portal-dim(portal_type: Portal, dim: Dim)
    < near_structure(portal_type)
    < leads_to(portal_type, dim)
    => (all b: Block) ~near_block(b)
    => (all e: Entity) ~near_entity(e)
    => (all s: Structure) ~near_structure(s)
    => (all d: Dim) ~in_dim(d)
    => in_dim(dim)



## Structures

task reach-structure(struc: Structure)

reach-structure : revisit(struc: Structure)
    - goto-memorized-structure(struc)
reach-structure : build(struc: Building)
    - build-building(struc)
reach-structure : find(struc: Structure)
    - find-structure(struc)

action goto-memorized-structure(struc: Structure)
    < structure_memorized(struc)
    => near_structure(struc)

task build-building(b: Building)

build-building : nether_portal_overworld(b: Building)
    < b = nether_portal_overworld
    - build-nether-portal-overworld()
build-building : nether_portal_nether(b: Building)
    < b = nether_portal_nether
    - build-nether-portal-nether()
build-building : lit_end_portal(b: Building)
    < b = lit_end_portal
    - build-lit-end-portal
build-building : lit_center_portal(b: Building)
    < b = lit_center_portal
    - kill-entity(e_ender_dragon)
    
action build-nether-portal-overworld
    ## i_obsidian 10 ->
    < has_item(i_obsidian)
    < in_dim(overworld)
    => near_structure(nether_portal_overworld)
    => structure_memorized(nether_portal_overworld)

action build-nether-portal-nether
    ## i_obsidian 10 ->
    < has_item(i_obsidian)
    < in_dim(nether)
    => near_structure(nether_portal_nether)
    => structure_memorized(nether_portal_nether)

action build-lit-end-portal
    ## i_eye_of_ender 12 -> 
    < near_structure(end_portal)
    < has_item(i_eye_of_ender)
    => near_structure(lit_end_portal)
    => structure_memorized(lit_end_portal)

task find-structure(struc: Structure)

find-structure : dono(struc: Structure)
    < near_structure(struc)
    - dono
find-structure : find(struc: Structure, dim: Dim)
    < findable_structure_in_dim(struc, dim)
    - goto-dim(dim)
    - find-structure-in-dim(struc, dim)

action find-structure-in-dim(struc: Structure, dim: Dim)
    < in_dim(dim)
    => (all b: Block) ~near_block(b)
    => (all e: Entity) ~near_entity(e)
    => (all s: Structure) ~near_structure(s)
    => near_structure(struc)


## Items

task acquire-item(item: Item)

acquire-item : dono(item: Item)
    < has_item(item)
    - dono

acquire-item : pickup(item: Item)
    - pickup-item(item)

action pickup-item(item: Item)
    ## -> item 1
    < near_item_entity(item)
    => ~near_item_entity(item)
    => has_item(item)

acquire-item : mine-block(item: Item, block: Block)
    < mined_becomes(block, item)
    - mine-block(block, item)

## acquire-item : reap-block(item: Item, block: Block, tool: Tool)
##     - reap-block(block, tool, item)

## acquire-item : container-take(item: Item, ctype: Container)
##     - container-take(ctype, item)

acquire-item : kill-entity(item: Item, entity: Entity)
    < killed_becomes(entity, item)
    - kill-entity-for-item(entity, item)

## acquire-item : reap-entity(item: Item, tool: Tool, entity: Entity)
##     < reaped_entity_becomes(entity, item)
##     - reap-entity(entity, tool, item)

acquire-item : craft(item: Item)
    - craft-item(item)

## task craft-item(item: Item)

# MACRO CRAFTING
