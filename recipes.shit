action recipe_wooden_shovel
    < near_block(b_crafting_table)
    < item_nr(i_#minecraft:planks) >= 1
    < item_nr(i_stick) >= 2
    => item_nr(i_#minecraft:planks) -= 1
    => item_nr(i_stick) -= 2
    => item_nr(i_wooden_shovel) += 1

action recipe_lapis_lazuli
    < item_nr(i_lapis_block) >= 1
    => item_nr(i_lapis_block) -= 1
    => item_nr(i_lapis_lazuli) += 9

action recipe_quartz_from_blasting
    < near_block(b_blast_furnace)
    < item_nr(i_nether_quartz_ore) >= 1
    => item_nr(i_nether_quartz_ore) -= 1
    => item_nr(i_quartz) += 1

action recipe_stripped_spruce_wood
    < item_nr(i_stripped_spruce_log) >= 4
    => item_nr(i_stripped_spruce_log) -= 4
    => item_nr(i_stripped_spruce_wood) += 3

action recipe_fletching_table
    < near_block(b_crafting_table)
    < item_nr(i_flint) >= 2
    < item_nr(i_#minecraft:planks) >= 4
